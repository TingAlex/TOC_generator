# 复制此文件为 .env 并填入真实密钥
# 优先级：SiliconFlow > DeepSeek > Anthropic > OpenAI

SILICONFLOW_API_KEY=sk-...   # 硅基流动，默认使用 deepseek-ai/DeepSeek-OCR（推荐）
DEEPSEEK_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# 可选：覆盖默认模型（如切换到 Qwen/Qwen2.5-VL-7B-Instruct 或 PaddlePaddle/PaddleOCR-VL）
LLM_MODEL=
